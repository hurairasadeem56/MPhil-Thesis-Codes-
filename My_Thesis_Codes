        "# ==========================================================\n",
        "# BLOCK 3C\n",
        "# Experiment 4\n",
        "# Sampling Strategy Comparison\n",
        "# Reusable PINN Framework\n",
        "# ==========================================================\n",
        "\n",
        "import deepxde as dde\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "from scipy.integrate import solve_ivp\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================================\n",
        "# Biological Parameters\n",
        "# ==========================================================\n",
        "\n",
        "alpha = 0.35          # Growth rate\n",
        "K = 1.0               # Carrying capacity\n",
        "N0 = 0.05             # Initial Tumor Volume\n",
        "\n",
        "# ==========================================================\n",
        "# Computational Domain\n",
        "# ==========================================================\n",
        "\n",
        "t0 = 0.0\n",
        "tfinal = 10.0\n",
        "\n",
        "geom = dde.geometry.TimeDomain(t0, tfinal)\n",
        "\n",
        "# ==========================================================\n",
        "# Exact Solution\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_exact(t):\n",
        "\n",
        "    return K*np.exp(\n",
        "\n",
        "        np.log(N0/K)\n",
        "\n",
        "        *\n",
        "\n",
        "        np.exp(-alpha*t)\n",
        "\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Numerical Reference Solution\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_rhs(t,y):\n",
        "\n",
        "    return alpha*y*np.log(K/y)\n",
        "\n",
        "time_reference = np.linspace(t0,tfinal,500)\n",
        "\n",
        "reference_solution = solve_ivp(\n",
        "\n",
        "    gompertz_rhs,\n",
        "\n",
        "    [t0,tfinal],\n",
        "\n",
        "    [N0],\n",
        "\n",
        "    t_eval=time_reference,\n",
        "\n",
        "    method=\"RK45\"\n",
        "\n",
        ")\n",
        "\n",
        "reference = reference_solution.y[0]\n",
        "\n",
        "# ==========================================================\n",
        "# Governing Equation\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_pde(t,y):\n",
        "\n",
        "    dy_dt = dde.grad.jacobian(y,t)\n",
        "\n",
        "    return dy_dt - alpha*y*tf.math.log(K/y)\n",
        "\n",
        "# ==========================================================\n",
        "# Initial Condition\n",
        "# ==========================================================\n",
        "\n",
        "def initial_boundary(x,on_initial):\n",
        "\n",
        "    return on_initial\n",
        "\n",
        "ic = dde.icbc.IC(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    lambda x: N0,\n",
        "\n",
        "    initial_boundary\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# MODEL BUILDER\n",
        "# ==========================================================\n",
        "\n",
        "def build_model(train_distribution):\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Training Dataset\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    data = dde.data.PDE(\n",
        "\n",
        "        geom,\n",
        "\n",
        "        gompertz_pde,\n",
        "\n",
        "        [ic],\n",
        "\n",
        "        num_domain=2000,\n",
        "\n",
        "        num_boundary=50,\n",
        "\n",
        "        train_distribution=train_distribution,\n",
        "\n",
        "        num_test=1000\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Fixed Best Architecture\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    layer_size = [\n",
        "\n",
        "        1,\n",
        "\n",
        "        64,\n",
        "\n",
        "        64,\n",
        "\n",
        "        64,\n",
        "\n",
        "        64,\n",
        "\n",
        "        1\n",
        "\n",
        "    ]\n",
        "\n",
        "    net = dde.nn.FNN(\n",
        "\n",
        "        layer_size,\n",
        "\n",
        "        activation=\"tanh\",\n",
        "\n",
        "        kernel_initializer=\"Glorot uniform\"\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Output Transformation\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    def output_transform(x,y):\n",
        "\n",
        "        return K*tf.math.sigmoid(y)\n",
        "\n",
        "    net.apply_output_transform(output_transform)\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Build Model\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    model = dde.Model(\n",
        "\n",
        "        data,\n",
        "\n",
        "        net\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Count Parameters\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    num_parameters = 0\n",
        "\n",
        "    for variable in net.trainable_variables:\n",
        "\n",
        "        num_parameters += np.prod(variable.shape)\n",
        "\n",
        "    return model, num_parameters, train_distribution\n",
        "\n",
        "# ==========================================================\n",
        "# Test Builder\n",
        "# ==========================================================\n",
        "\n",
        "test_model, test_params, sampling = build_model(\"LHS\")\n",
        "\n",
        "print(\"=\"*65)\n",
        "print(\"SAMPLING STRATEGY FRAMEWORK READY\")\n",
        "print(\"=\"*65)\n",
        "\n",
        "print(\"Architecture        : L4N64\")\n",
        "print(f\"Sampling Strategy   : {sampling}\")\n",
        "print(f\"Trainable Parameters: {test_params:,}\")\n",
        "\n",
        "print(f\"Time Domain         : {t0} to {tfinal}\")\n",
        "print(f\"Collocation Points  : 2000\")\n",
        "print(f\"Boundary Points     : 50\")\n",
        "print(\"Optimizer           : Adam + L-BFGS\")\n",
        "print(\"Noise               : 0 %\")\n",
        "print(\"=\"*65)\n",
        "\n",
        "# ==========================================================\n",
        "# Plot Reference Solution\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "\n",
        "    time_reference,\n",
        "\n",
        "    reference,\n",
        "\n",
        "    linewidth=3,\n",
        "\n",
        "    label=\"Reference Solution\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Time\")\n",
        "plt.ylabel(\"Tumor Volume\")\n",
        "plt.title(\"Reference Gompertz Tumor Growth\")\n",
        "plt.grid(True)\n",
        "plt.legend()\n",
        "\n",
        "plt.show()"
      ]
