        "# ==========================================================\n",
        "# BLOCK 3\n",
        "# Gene Expression Model\n",
        "# Reusable PINN Framework\n",
        "# ==========================================================\n",
        "\n",
        "import deepxde as dde\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from scipy.integrate import solve_ivp\n",
        "\n",
        "# ==========================================================\n",
        "# Biological Parameters\n",
        "# ==========================================================\n",
        "\n",
        "alpha_m = 1.0      # mRNA transcription rate\n",
        "beta_m  = 0.5      # mRNA degradation rate\n",
        "\n",
        "alpha_p = 2.0      # protein translation rate\n",
        "beta_p  = 0.4      # protein degradation rate\n",
        "\n",
        "m0 = 0.0           # initial mRNA concentration\n",
        "p0 = 0.0           # initial protein concentration\n",
        "\n",
        "# ==========================================================\n",
        "# Computational Domain\n",
        "# ==========================================================\n",
        "\n",
        "t0 = 0.0\n",
        "tfinal = 10.0\n",
        "\n",
        "geom = dde.geometry.TimeDomain(t0, tfinal)\n",
        "\n",
        "# ==========================================================\n",
        "# Analytical Solution\n",
        "# ==========================================================\n",
        "\n",
        "def mrna_exact(t):\n",
        "\n",
        "    return (\n",
        "\n",
        "        alpha_m/beta_m\n",
        "\n",
        "        +\n",
        "\n",
        "        (m0-alpha_m/beta_m)\n",
        "\n",
        "        *\n",
        "\n",
        "        np.exp(-beta_m*t)\n",
        "\n",
        "    )\n",
        "\n",
        "def protein_exact(t):\n",
        "\n",
        "    steady = alpha_p*alpha_m/(beta_m*beta_p)\n",
        "\n",
        "    A = alpha_p*(m0-alpha_m/beta_m)/(beta_p-beta_m)\n",
        "\n",
        "    B = p0-steady-A\n",
        "\n",
        "    return (\n",
        "\n",
        "        steady\n",
        "\n",
        "        +\n",
        "\n",
        "        A*np.exp(-beta_m*t)\n",
        "\n",
        "        +\n",
        "\n",
        "        B*np.exp(-beta_p*t)\n",
        "\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Numerical Reference Solution\n",
        "# ==========================================================\n",
        "\n",
        "def gene_rhs(t,y):\n",
        "\n",
        "    m = y[0]\n",
        "    p = y[1]\n",
        "\n",
        "    dm = alpha_m-beta_m*m\n",
        "\n",
        "    dp = alpha_p*m-beta_p*p\n",
        "\n",
        "    return [dm,dp]\n",
        "\n",
        "time_reference = np.linspace(\n",
        "\n",
        "    t0,\n",
        "\n",
        "    tfinal,\n",
        "\n",
        "    500\n",
        "\n",
        ")\n",
        "\n",
        "reference_solution = solve_ivp(\n",
        "\n",
        "    gene_rhs,\n",
        "\n",
        "    [t0,tfinal],\n",
        "\n",
        "    [m0,p0],\n",
        "\n",
        "    t_eval=time_reference,\n",
        "\n",
        "    method=\"RK45\"\n",
        "\n",
        ")\n",
        "\n",
        "reference_m = reference_solution.y[0]\n",
        "\n",
        "reference_p = reference_solution.y[1]\n",
        "\n",
        "# ==========================================================\n",
        "# PINN Residuals\n",
        "# ==========================================================\n",
        "\n",
        "def gene_pde(t,y):\n",
        "\n",
        "    m = y[:,0:1]\n",
        "\n",
        "    p = y[:,1:2]\n",
        "\n",
        "    dm_dt = dde.grad.jacobian(\n",
        "\n",
        "        y,\n",
        "\n",
        "        t,\n",
        "\n",
        "        i=0\n",
        "\n",
        "    )\n",
        "\n",
        "    dp_dt = dde.grad.jacobian(\n",
        "\n",
        "        y,\n",
        "\n",
        "        t,\n",
        "\n",
        "        i=1\n",
        "\n",
        "    )\n",
        "\n",
        "    eq1 = dm_dt-(alpha_m-beta_m*m)\n",
        "\n",
        "    eq2 = dp_dt-(alpha_p*m-beta_p*p)\n",
        "\n",
        "    return [\n",
        "\n",
        "        eq1,\n",
        "\n",
        "        eq2\n",
        "\n",
        "    ]\n",
        "\n",
        "# ==========================================================\n",
        "# Initial Conditions\n",
        "# ==========================================================\n",
        "\n",
        "def boundary(x,on_initial):\n",
        "\n",
        "    return on_initial\n",
        "\n",
        "ic_m = dde.icbc.IC(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    lambda x:m0,\n",
        "\n",
        "    boundary,\n",
        "\n",
        "    component=0\n",
        "\n",
        ")\n",
        "\n",
        "ic_p = dde.icbc.IC(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    lambda x:p0,\n",
        "\n",
        "    boundary,\n",
        "\n",
        "    component=1\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Dataset\n",
        "# ==========================================================\n",
        "\n",
        "data = dde.data.PDE(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    gene_pde,\n",
        "\n",
        "    [\n",
        "\n",
        "        ic_m,\n",
        "\n",
        "        ic_p\n",
        "\n",
        "    ],\n",
        "\n",
        "    num_domain=2000,\n",
        "\n",
        "    num_boundary=50,\n",
        "\n",
        "    train_distribution=\"LHS\",\n",
        "\n",
        "    num_test=1000\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Reusable Model Builder\n",
        "# ==========================================================\n",
        "\n",
        "def build_model(hidden_layers,neurons):\n",
        "\n",
        "    layer_size=[1]\n",
        "\n",
        "    for _ in range(hidden_layers):\n",
        "\n",
        "        layer_size.append(neurons)\n",
        "\n",
        "    layer_size.append(2)\n",
        "\n",
        "    net = dde.nn.FNN(\n",
        "\n",
        "        layer_size,\n",
        "\n",
        "        activation=\"tanh\",\n",
        "\n",
        "        kernel_initializer=\"Glorot uniform\"\n",
        "\n",
        "    )\n",
        "\n",
        "    model = dde.Model(\n",
        "\n",
        "        data,\n",
        "\n",
        "        net\n",
        "\n",
        "    )\n",
        "\n",
        "    num_parameters=0\n",
        "\n",
        "    for var in net.trainable_variables:\n",
        "\n",
        "        num_parameters += np.prod(var.shape)\n",
        "\n",
        "    return model,num_parameters,layer_size\n",
        "\n",
        "# ==========================================================\n",
        "# Test Framework\n",
        "# ==========================================================\n",
        "\n",
        "test_model,test_params,test_arch = build_model(\n",
        "\n",
        "    4,\n",
        "\n",
        "    64\n",
        "\n",
        ")\n",
        "\n",
        "print(\"=\"*65)\n",
        "print(\"GENE EXPRESSION PINN READY\")\n",
        "print(\"=\"*65)\n",
        "\n",
        "print(\"Architecture        :\",test_arch)\n",
        "\n",
        "print(\"Trainable Parameters:\",test_params)\n",
        "\n",
        "print(\"Time Domain         :\",t0,\"to\",tfinal)\n",
        "\n",
        "print(\"Collocation Points  : 2000\")\n",
        "\n",
        "print(\"Boundary Points     : 50\")\n",
        "\n",
        "print(\"Sampling            : Latin Hypercube\")\n",
        "\n",
        "print(\"=\"*65)\n",
        "\n",
        "# ==========================================================\n",
        "# Plot Reference Solutions\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "\n",
        "    time_reference,\n",
        "\n",
        "    reference_m,\n",
        "\n",
        "    linewidth=3,\n",
        "\n",
        "    label=\"mRNA\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "\n",
        "    time_reference,\n",
        "\n",
        "    reference_p,\n",
        "\n",
        "    linewidth=3,\n",
        "\n",
        "    label=\"Protein\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Time\")\n",
        "\n",
        "plt.ylabel(\"Concentration\")\n",
        "\n",
        "plt.title(\"Reference Gene Expression Dynamics\")\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "plt.legend()\n",
        "\n",
        "plt.show()"
      ]
    },
