        "    linewidth=3,\n",
        "\n",
        "    label=\"Exact mRNA\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "\n",
        "    test_t,\n",
        "\n",
        "    test_m,\n",
        "\n",
        "    s=15,\n",
        "\n",
        "    alpha=0.6,\n",
        "\n",
        "    label=\"Noisy mRNA\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "\n",
        "    time_reference,\n",
        "\n",
        "    reference_p,\n",
        "\n",
        "    linewidth=3,\n",
        "\n",
        "    label=\"Exact Protein\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "\n",
        "    test_t,\n",
        "\n",
        "    test_p,\n",
        "\n",
        "    s=15,\n",
        "\n",
        "    alpha=0.6,\n",
        "\n",
        "    label=\"Noisy Protein\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Time\")\n",
        "\n",
        "plt.ylabel(\"Concentration\")\n",
        "\n",
        "plt.title(\"Gene Expression with Noisy Observations\")\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "plt.legend()\n",
        "\n",
        "plt.show()"
