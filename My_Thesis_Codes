        "# ==========================================================\n",
        "# BLOCK 3B\n",
        "# Experiment 3\n",
        "# Robustness Against Noisy Observations\n",
        "# Reusable PINN Framework\n",
        "# ==========================================================\n",
        "\n",
        "import deepxde as dde\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from scipy.integrate import solve_ivp\n",
        "\n",
        "# ==========================================================\n",
        "# Biological Parameters\n",
        "# ==========================================================\n",
        "\n",
        "alpha_m = 1.0\n",
        "beta_m  = 0.5\n",
        "\n",
        "alpha_p = 2.0\n",
        "beta_p  = 0.4\n",
        "\n",
        "m0 = 0.0\n",
        "p0 = 0.0\n",
        "\n",
        "# ==========================================================\n",
        "# Computational Domain\n",
        "# ==========================================================\n",
        "\n",
        "t0 = 0.0\n",
        "tfinal = 10.0\n",
        "\n",
        "geom = dde.geometry.TimeDomain(t0,tfinal)\n",
        "\n",
        "# ==========================================================\n",
        "# Analytical Solutions\n",
        "# ==========================================================\n",
        "\n",
        "def mrna_exact(t):\n",
        "\n",
        "    return (\n",
        "\n",
        "        alpha_m/beta_m\n",
        "\n",
        "        +\n",
        "\n",
        "        (m0-alpha_m/beta_m)\n",
        "\n",
        "        *\n",
        "\n",
        "        np.exp(-beta_m*t)\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "def protein_exact(t):\n",
        "\n",
        "    steady = alpha_p*alpha_m/(beta_m*beta_p)\n",
        "\n",
        "    A = alpha_p*(m0-alpha_m/beta_m)/(beta_p-beta_m)\n",
        "\n",
        "    B = p0-steady-A\n",
        "\n",
        "    return (\n",
        "\n",
        "        steady\n",
        "\n",
        "        +\n",
        "\n",
        "        A*np.exp(-beta_m*t)\n",
        "\n",
        "        +\n",
        "\n",
        "        B*np.exp(-beta_p*t)\n",
        "\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Numerical Reference Solution\n",
        "# ==========================================================\n",
        "\n",
        "def gene_rhs(t,y):\n",
        "\n",
        "    m = y[0]\n",
        "    p = y[1]\n",
        "\n",
        "    dm = alpha_m-beta_m*m\n",
        "\n",
        "    dp = alpha_p*m-beta_p*p\n",
        "\n",
        "    return [dm,dp]\n",
        "\n",
        "\n",
        "time_reference = np.linspace(\n",
        "\n",
        "    t0,\n",
        "\n",
        "    tfinal,\n",
        "\n",
        "    500\n",
        "\n",
        ")\n",
        "\n",
        "reference_solution = solve_ivp(\n",
        "\n",
        "    gene_rhs,\n",
        "\n",
        "    [t0,tfinal],\n",
        "\n",
        "    [m0,p0],\n",
        "\n",
        "    t_eval=time_reference,\n",
        "\n",
        "    method=\"RK45\"\n",
        "\n",
        ")\n",
        "\n",
        "reference_m = reference_solution.y[0]\n",
        "\n",
        "reference_p = reference_solution.y[1]\n",
        "\n",
        "# ==========================================================\n",
        "# Governing Equations\n",
        "# ==========================================================\n",
        "\n",
        "def gene_pde(t,y):\n",
        "\n",
        "    m = y[:,0:1]\n",
        "\n",
        "    p = y[:,1:2]\n",
        "\n",
        "    dm_dt = dde.grad.jacobian(\n",
        "\n",
        "        y,\n",
        "\n",
        "        t,\n",
        "\n",
        "        i=0\n",
        "\n",
        "    )\n",
        "\n",
        "    dp_dt = dde.grad.jacobian(\n",
        "\n",
        "        y,\n",
        "\n",
        "        t,\n",
        "\n",
        "        i=1\n",
        "\n",
        "    )\n",
        "\n",
        "    eq1 = dm_dt-(alpha_m-beta_m*m)\n",
        "\n",
        "    eq2 = dp_dt-(alpha_p*m-beta_p*p)\n",
        "\n",
        "    return [\n",
        "\n",
        "        eq1,\n",
        "\n",
        "        eq2\n",
        "\n",
        "    ]\n",
        "\n",
        "# ==========================================================\n",
        "# Initial Conditions\n",
        "# ==========================================================\n",
        "\n",
        "def boundary(x,on_initial):\n",
        "\n",
        "    return on_initial\n",
        "\n",
        "\n",
        "ic_m = dde.icbc.IC(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    lambda x:m0,\n",
        "\n",
        "    boundary,\n",
        "\n",
        "    component=0\n",
        "\n",
        ")\n",
        "\n",
        "ic_p = dde.icbc.IC(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    lambda x:p0,\n",
        "\n",
        "    boundary,\n",
        "\n",
        "    component=1\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# REUSABLE MODEL BUILDER\n",
        "# Noise Levels:\n",
        "# 0\n",
        "# 5\n",
        "# 10\n",
        "# ==========================================================\n",
        "\n",
        "def build_model(noise_percent):\n",
        "\n",
        "    np.random.seed(1234)\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Observation Points\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    observe_t = np.linspace(\n",
        "\n",
        "        t0,\n",
        "\n",
        "        tfinal,\n",
        "\n",
        "        200\n",
        "\n",
        "    ).reshape(-1,1)\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Exact Observations\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    m_exact = mrna_exact(\n",
        "\n",
        "        observe_t.flatten()\n",
        "\n",
        "    )\n",
        "\n",
        "    p_exact = protein_exact(\n",
        "\n",
        "        observe_t.flatten()\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Gaussian Noise\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    sigma = noise_percent/100.0\n",
        "\n",
        "    noisy_m = (\n",
        "\n",
        "        m_exact\n",
        "\n",
        "        +\n",
        "\n",
        "        sigma\n",
        "\n",
        "        *\n",
        "\n",
        "        np.std(m_exact)\n",
        "\n",
        "        *\n",
        "\n",
        "        np.random.randn(\n",
        "\n",
        "            len(m_exact)\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    noisy_p = (\n",
        "\n",
        "        p_exact\n",
        "\n",
        "        +\n",
        "\n",
        "        sigma\n",
        "\n",
        "        *\n",
        "\n",
        "        np.std(p_exact)\n",
        "\n",
        "        *\n",
        "\n",
        "        np.random.randn(\n",
        "\n",
        "            len(p_exact)\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Observation Constraints\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    observe_m = dde.icbc.PointSetBC(\n",
        "\n",
        "        observe_t,\n",
        "\n",
        "        noisy_m.reshape(-1,1),\n",
        "\n",
        "        component=0\n",
        "\n",
        "    )\n",
        "\n",
        "    observe_p = dde.icbc.PointSetBC(\n",
        "\n",
        "        observe_t,\n",
        "\n",
        "        noisy_p.reshape(-1,1),\n",
        "\n",
        "        component=1\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Dataset\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    data = dde.data.PDE(\n",
        "\n",
        "        geom,\n",
        "\n",
        "        gene_pde,\n",
        "\n",
        "        [\n",
        "\n",
        "            ic_m,\n",
        "\n",
        "            ic_p,\n",
        "\n",
        "            observe_m,\n",
        "\n",
        "            observe_p\n",
        "\n",
        "        ],\n",
        "\n",
        "        num_domain=2000,\n",
        "\n",
        "        num_boundary=50,\n",
        "\n",
        "        train_distribution=\"LHS\",\n",
        "\n",
        "        num_test=1000\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Best Architecture\n",
        "    # From Experiment 2\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    layer_size = [\n",
        "\n",
        "        1,\n",
        "\n",
        "        128,\n",
        "\n",
        "        128,\n",
        "\n",
        "        128,\n",
        "\n",
        "        2\n",
        "\n",
        "    ]\n",
        "\n",
        "    net = dde.nn.FNN(\n",
        "\n",
        "        layer_size,\n",
        "\n",
        "        activation=\"tanh\",\n",
        "\n",
        "        kernel_initializer=\"Glorot uniform\"\n",
        "\n",
        "    )\n",
        "\n",
        "    model = dde.Model(\n",
        "\n",
        "        data,\n",
        "\n",
        "        net\n",
        "\n",
        "    )\n",
        "\n",
        "    return (\n",
        "\n",
        "        model,\n",
        "\n",
        "        observe_t,\n",
        "\n",
        "        noisy_m,\n",
        "\n",
        "        noisy_p\n",
        "\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Test Framework\n",
        "# ==========================================================\n",
        "\n",
        "test_model, test_t, test_m, test_p = build_model(5)\n",
        "\n",
        "print(\"=\"*65)\n",
        "print(\"GENE EXPRESSION NOISE FRAMEWORK READY\")\n",
        "print(\"=\"*65)\n",
        "\n",
        "print(\"Architecture        : L3N128\")\n",
        "print(\"Observation Points  : 200\")\n",
        "print(\"Collocation Points  : 2000\")\n",
        "print(\"Noise Example       : 5 %\")\n",
        "print(\"Sampling            : Latin Hypercube\")\n",
        "print(\"=\"*65)\n",
        "\n",
        "# ==========================================================\n",
        "# Visualization\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "\n",
        "    time_reference,\n",
        "\n",
        "    reference_m,\n",
