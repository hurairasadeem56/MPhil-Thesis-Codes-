        "# BLOCK 3C\n",
        "# Reusable Framework\n",
        "# Experiment 4\n",
        "# Sampling Strategy Comparison\n",
        "# ==========================================================\n",
        "\n",
        "# ==========================================================\n",
        "# Reusable Model Builder\n",
        "# ==========================================================\n",
        "\n",
        "def build_model(hidden_layers,\n",
        "                neurons,\n",
        "                sampling_method=\"LHS\"):\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Dataset\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    data = dde.data.PDE(\n",
        "\n",
        "        geom,\n",
        "\n",
        "        gene_pde,\n",
        "\n",
        "        [\n",
        "\n",
        "            ic_m,\n",
        "\n",
        "            ic_p\n",
        "\n",
        "        ],\n",
        "\n",
        "        num_domain=2000,\n",
        "\n",
        "        num_boundary=50,\n",
        "\n",
        "        train_distribution=sampling_method,\n",
        "\n",
        "        num_test=1000\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Network Architecture\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    layer_size = [1]\n",
        "\n",
        "    for _ in range(hidden_layers):\n",
        "\n",
        "        layer_size.append(neurons)\n",
        "\n",
        "    layer_size.append(2)\n",
        "\n",
        "    net = dde.nn.FNN(\n",
        "\n",
        "        layer_size,\n",
        "\n",
        "        activation=\"tanh\",\n",
        "\n",
        "        kernel_initializer=\"Glorot uniform\"\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Build Model\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    model = dde.Model(\n",
        "\n",
        "        data,\n",
        "\n",
        "        net\n",
        "\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Count Parameters\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    num_parameters = 0\n",
        "\n",
        "    for variable in net.trainable_variables:\n",
        "\n",
        "        num_parameters += np.prod(variable.shape)\n",
        "\n",
        "    return (\n",
        "\n",
        "        model,\n",
        "\n",
        "        num_parameters,\n",
        "\n",
        "        layer_size\n",
        "\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Test Framework\n",
