        "# ==========================================================\n",
        "# BLOCK 3B\n",
        "# Gompertz PINN Framework\n",
        "# Experiment 3\n",
        "# Noise Robustness Analysis\n",
        "# ==========================================================\n",
        "\n",
        "import deepxde as dde\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from scipy.integrate import solve_ivp\n",
        "\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# Experiment Information\n",
        "# ==========================================================\n",
        "\n",
        "NOISE_LEVEL = 10      # Change to 5 or 10 later\n",
        "\n",
        "# ==========================================================\n",
        "# Biological Parameters\n",
        "# ==========================================================\n",
        "\n",
        "alpha = 0.35\n",
        "K = 1.0\n",
        "N0 = 0.05\n",
        "\n",
        "# ==========================================================\n",
        "# Computational Domain\n",
        "# ==========================================================\n",
        "\n",
        "\n",
        "t0 = 0.0\n",
        "tfinal = 10.0\n",
        "\n",
        "geom = dde.geometry.TimeDomain(t0, tfinal)\n",
        "\n",
        "# ==========================================================\n",
        "# Exact Analytical Solution\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_exact(t):\n",
        "\n",
        "    return K*np.exp(\n",
        "\n",
        "        np.log(N0/K)\n",
        "\n",
        "        *\n",
        "\n",
        "        np.exp(-alpha*t)\n",
        "\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Numerical Reference Solution\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_rhs(t,y):\n",
        "\n",
        "    return alpha*y*np.log(K/y)\n",
        "\n",
        "time_reference = np.linspace(t0,tfinal,500)\n",
        "\n",
        "reference_solution = solve_ivp(\n",
        "\n",
        "    gompertz_rhs,\n",
        "\n",
        "    [t0,tfinal],\n",
        "\n",
        "    [N0],\n",
        "\n",
        "    t_eval=time_reference,\n",
        "\n",
        "    method=\"RK45\"\n",
        "\n",
        ")\n",
        "\n",
        "reference = reference_solution.y[0]\n",
        "\n",
        "# ==========================================================\n",
        "# Physics Equation\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_pde(t,y):\n",
        "\n",
        "    dy_dt = dde.grad.jacobian(y,t)\n",
        "\n",
        "    return dy_dt - alpha*y*tf.math.log(K/y)\n",
        "\n",
        "# ==========================================================\n",
        "# Initial Condition\n",
        "# ==========================================================\n",
        "\n",
        "def initial_boundary(x,on_initial):\n",
        "\n",
        "    return on_initial\n",
        "\n",
        "ic = dde.icbc.IC(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    lambda x: N0,\n",
        "\n",
        "    initial_boundary\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Observation Locations\n",
        "# (Same locations for every experiment)\n",
        "# ==========================================================\n",
        "\n",
        "NUM_OBSERVATIONS = 50\n",
        "\n",
        "t_obs = np.linspace(\n",
        "\n",
        "    t0,\n",
        "\n",
        "    tfinal,\n",
        "\n",
        "    NUM_OBSERVATIONS\n",
        "\n",
        ").reshape(-1,1)\n",
        "\n",
        "y_exact_obs = gompertz_exact(\n",
        "\n",
        "    t_obs.flatten()\n",
        "\n",
        ").reshape(-1,1)\n",
        "\n",
        "# ==========================================================\n",
        "# Noise Generator\n",
        "# ==========================================================\n",
        "\n",
        "def generate_noisy_observations(noise_percent):\n",
        "\n",
        "    \"\"\"\n",
        "    noise_percent = 0\n",
        "                    5\n",
        "                    10\n",
        "    \"\"\"\n",
        "\n",
        "    noise_std = (noise_percent/100.0)*np.std(y_exact_obs)\n",
        "\n",
        "    noisy_values = (\n",
        "\n",
        "        y_exact_obs\n",
        "\n",
        "        +\n",
        "\n",
        "        noise_std*np.random.randn(\n",
        "\n",
        "            *y_exact_obs.shape\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    return noisy_values\n",
        "\n",
        "# ==========================================================\n",
        "# Dataset Builder\n",
        "# ==========================================================\n",
        "\n",
        "def build_dataset(noise_percent):\n",
        "\n",
        "    noisy_data = generate_noisy_observations(\n",
        "\n",
        "        noise_percent\n",
        "\n",
        "    )\n",
        "\n",
        "    observe_y = dde.icbc.PointSetBC(\n",
        "\n",
        "        t_obs,\n",
        "\n",
        "        noisy_data,\n",
        "\n",
        "        component=0\n",
        "\n",
        "    )\n",
        "\n",
        "    data = dde.data.PDE(\n",
        "\n",
        "        geom,\n",
        "\n",
        "        gompertz_pde,\n",
        "\n",
        "        [\n",
        "\n",
        "            ic,\n",
        "\n",
        "            observe_y\n",
        "\n",
        "        ],\n",
        "\n",
        "        num_domain=2000,\n",
        "\n",
        "        num_boundary=50,\n",
        "\n",
        "        train_distribution=\"LHS\",\n",
        "\n",
        "        num_test=1000\n",
        "\n",
        "    )\n",
        "\n",
        "    return data,noisy_data\n",
        "\n",
        "# ==========================================================\n",
        "# Reusable Model Builder\n",
        "# (Optimal Architecture from Experiment 2)\n",
        "# ==========================================================\n",
        "\n",
        "def build_model(noise_percent):\n",
        "\n",
        "    data,noisy_data = build_dataset(\n",
        "\n",
        "        noise_percent\n",
        "\n",
        "    )\n",
        "\n",
        "    layer_size = [\n",
        "\n",
        "        1,\n",
        "\n",
        "        64,\n",
        "\n",
        "        64,\n",
        "\n",
        "        64,\n",
        "\n",
        "        64,\n",
        "\n",
        "        1\n",
        "\n",
        "    ]\n",
        "\n",
        "    net = dde.nn.FNN(\n",
        "\n",
        "        layer_size,\n",
        "\n",
        "        activation=\"tanh\",\n",
        "\n",
        "        kernel_initializer=\"Glorot uniform\"\n",
        "\n",
        "    )\n",
        "\n",
        "    # ---------------------------------------------\n",
        "    # Output Transformation\n",
        "    # Ensures 0 < N(t) < K\n",
        "    # ---------------------------------------------\n",
        "\n",
        "    def output_transform(x,y):\n",
        "\n",
        "        return K*tf.math.sigmoid(y)\n",
        "\n",
        "    net.apply_output_transform(\n",
        "\n",
        "        output_transform\n",
        "\n",
        "    )\n",
        "\n",
        "    model = dde.Model(\n",
        "\n",
        "        data,\n",
        "\n",
        "        net\n",
        "\n",
        "    )\n",
        "\n",
        "    return model,noisy_data\n",
        "\n",
        "# ==========================================================\n",
        "# Test Framework\n",
        "# ==========================================================\n",
        "\n",
        "model,test_noisy = build_model(NOISE_LEVEL)\n",
        "\n",
        "print(\"=\"*65)\n",
        "print(\"NOISE ROBUSTNESS FRAMEWORK READY\")\n",
        "print(\"=\"*65)\n",
        "\n",
        "print(\"Architecture          : L4N64\")\n",
        "print(\"Optimizer             : Adam + L-BFGS\")\n",
        "print(\"Observation Points    :\",NUM_OBSERVATIONS)\n",
        "print(\"Collocation Points    : 2000\")\n",
        "print(\"Boundary Points       : 50\")\n",
        "print(f\"Noise Example         : {NOISE_LEVEL} %\")\n",
        "print(\"Output Constraint     : 0 < N(t) < K\")\n",
        "\n",
        "print(\"=\"*65)\n",
        "\n",
        "# ==========================================================\n",
        "# Visualization\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "\n",
        "    time_reference,\n",
        "\n",
        "    reference,\n",
        "\n",
        "    linewidth=3,\n",
        "\n",
        "    label=\"Exact Solution\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "\n",
        "    t_obs,\n",
        "\n",
        "    test_noisy,\n",
        "\n",
        "    color=\"red\",\n",
        "\n",
        "    s=30,\n",
        "\n",
        "    label=f\"{NOISE_LEVEL}% Noisy Observations\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Time\")\n",
        "plt.ylabel(\"Tumor Volume\")\n",
        "plt.title(\n",
        "    f\"Training Observations with {NOISE_LEVEL}% Noise\"\n",
        ")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
