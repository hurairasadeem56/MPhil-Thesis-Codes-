        "# ==========================================================\n",
        "# BLOCK 3\n",
        "# Gompertz Tumor Growth Model\n",
        "# PINN Problem Definition\n",
        "# ==========================================================\n",
        "\n",
        "import deepxde as dde\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "from scipy.integrate import solve_ivp\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================================\n",
        "# Biological Parameters\n",
        "# ==========================================================\n",
        "\n",
        "alpha = 0.35          # Growth rate\n",
        "K = 1.0               # Carrying capacity\n",
        "N0 = 0.05             # Initial tumor volume\n",
        "\n",
        "# ==========================================================\n",
        "# Computational Domain\n",
        "# ==========================================================\n",
        "\n",
        "t0 = 0.0\n",
        "tfinal = 10.0\n",
        "\n",
        "geom = dde.geometry.TimeDomain(t0, tfinal)\n",
        "\n",
        "# ==========================================================\n",
        "# Exact Analytical Solution\n",
        "#\n",
        "# N(t)=K exp( ln(N0/K) exp(-alpha*t) )\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_exact(t):\n",
        "\n",
        "    return K*np.exp(\n",
        "\n",
        "        np.log(N0/K)\n",
        "\n",
        "        *\n",
        "\n",
        "        np.exp(-alpha*t)\n",
        "\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Numerical Reference Solution\n",
        "#\n",
        "# Used only for verification\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_rhs(t,y):\n",
        "\n",
        "    return alpha*y*np.log(K/y)\n",
        "\n",
        "time_reference = np.linspace(t0,tfinal,500)\n",
        "\n",
        "reference_solution = solve_ivp(\n",
        "\n",
        "    gompertz_rhs,\n",
        "\n",
        "    [t0,tfinal],\n",
        "\n",
        "    [N0],\n",
        "\n",
        "    t_eval=time_reference,\n",
        "\n",
        "    method=\"RK45\"\n",
        "\n",
        ")\n",
        "\n",
        "reference = reference_solution.y[0]\n",
        "\n",
        "# ==========================================================\n",
        "# Physics Equation\n",
        "#\n",
        "# dy/dt = alpha*y*log(K/y)\n",
        "#\n",
        "# Output transformation guarantees\n",
        "#\n",
        "# 0 < y < K\n",
        "#\n",
        "# therefore no log singularity exists.\n",
        "# ==========================================================\n",
        "\n",
        "def gompertz_pde(t,y):\n",
        "\n",
        "    dy_dt = dde.grad.jacobian(y,t)\n",
        "\n",
        "    return dy_dt - alpha*y*tf.math.log(K/y)\n",
        "\n",
        "# ==========================================================\n",
        "# Initial Condition\n",
        "# ==========================================================\n",
        "\n",
        "def initial_boundary(x,on_initial):\n",
        "\n",
        "    return on_initial\n",
        "\n",
        "ic = dde.icbc.IC(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    lambda x: N0,\n",
        "\n",
        "    initial_boundary\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Training Dataset\n",
        "#\n",
        "# Latin Hypercube Sampling\n",
        "# ==========================================================\n",
        "\n",
        "data = dde.data.PDE(\n",
        "\n",
        "    geom,\n",
        "\n",
        "    gompertz_pde,\n",
        "\n",
        "    [ic],\n",
        "\n",
        "    num_domain=2000,\n",
        "\n",
        "    num_boundary=50,\n",
        "\n",
        "    train_distribution=\"LHS\",\n",
        "\n",
        "    num_test=1000\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# PINN Architecture\n",
        "#\n",
        "# 1\n",
        "# ↓\n",
        "# 64\n",
        "# ↓\n",
        "# 64\n",
        "# ↓\n",
        "# 64\n",
        "# ↓\n",
        "# 64\n",
        "# ↓\n",
        "# 1\n",
        "# ==========================================================\n",
        "\n",
        "layer_size = [\n",
        "\n",
        "    1,\n",
        "\n",
        "    64,\n",
        "\n",
        "    64,\n",
        "\n",
        "    64,\n",
        "\n",
        "    64,\n",
        "\n",
        "    1\n",
        "\n",
        "]\n",
        "\n",
        "net = dde.nn.FNN(\n",
        "\n",
        "    layer_size,\n",
        "\n",
        "    activation=\"tanh\",\n",
        "\n",
        "    kernel_initializer=\"Glorot uniform\"\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Output Transformation\n",
        "#\n",
        "# Very Important\n",
        "#\n",
        "# Guarantees\n",
        "#\n",
        "# 0 < N(t) < K\n",
        "#\n",
        "# making the logarithm always valid.\n",
        "#\n",
        "# N = K*sigmoid(z)\n",
        "# ==========================================================\n",
        "\n",
        "def output_transform(x,y):\n",
        "\n",
        "    return K*tf.math.sigmoid(y)\n",
        "\n",
        "net.apply_output_transform(output_transform)\n",
        "\n",
        "# ==========================================================\n",
        "# Build PINN Model\n",
        "# ==========================================================\n",
        "\n",
        "model = dde.Model(\n",
        "\n",
        "    data,\n",
        "\n",
        "    net\n",
        "\n",
        ")\n",
        "\n",
        "print(\"=\"*60)\n",
        "\n",
        "print(\"PINN MODEL SUCCESSFULLY CREATED\")\n",
        "\n",
        "print(\"=\"*60)\n",
        "\n",
        "print(\"Time Domain          :\",t0,\"to\",tfinal)\n",
        "\n",
        "print(\"Collocation Points   :\",2000)\n",
        "\n",
        "print(\"Boundary Points      :\",50)\n",
        "\n",
        "print(\"Network              : 4 Hidden Layers\")\n",
        "\n",
        "print(\"Neurons per Layer    : 64\")\n",
        "\n",
        "print(\"Activation           : tanh\")\n",
        "\n",
        "print(\"Sampling             : Latin Hypercube\")\n",
        "\n",
        "print(\"Output Constraint    : 0 < N(t) < K\")\n",
        "\n",
        "print(\"=\"*60)\n",
        "\n",
        "# ==========================================================\n",
        "# Plot Reference Solution\n",
        "# ==========================================================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(\n",
        "\n",
        "    time_reference,\n",
        "\n",
        "    reference,\n",
        "\n",
        "    linewidth=3,\n",
        "\n",
        "    label=\"Reference Solution\"\n",
        "\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Time\")\n",
        "\n",
        "plt.ylabel(\"Tumor Volume\")\n",
        "\n",
        "plt.title(\"Reference Gompertz Tumor Growth\")\n",
        "\n",
        "plt.grid(True)\n",
        "\n",
        "plt.legend()\n",
        "\n",
        "plt.show()"
      ]
